{% extends 'base.html.twig' %}

{% block title %}{{ 'glossary_trainer.page_title'|trans }}{% endblock %}

{% block body %}

    {% set gradeClass = {1: 'is-danger', 2: 'is-warning', 3: 'is-success', 4: 'is-info'} %}

    <section class="section">
        <div class="container">
            <div class="columns is-centered">
                <div class="column is-half">

                    <progress class="progress is-small is-link mb-1" value="{{ session.answered }}" max="{{ session.total }}">{{ session.answered }} / {{ session.total }}</progress>
                    <div class="level is-mobile mb-4">
                        <div class="level-left">
                            <p class="is-size-7 has-text-grey">
                                {{ 'glossary_trainer.progress'|trans({'%done%': session.answered, '%total%': session.total}) }}
                                - {{ session.mode.label()|trans }} - {{ session.direction.label()|trans }}
                            </p>
                        </div>
                        <div class="level-right">
                            <form method="post" action="{{ path('app_plugin_glossary_trainer_stop') }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('glossary_trainer_stop') }}">
                                <button type="submit" class="button is-small is-light">
                                    <span class="icon"><i class="fa fa-arrow-left"></i></span>
                                    <span>{{ 'glossary_trainer.button_stop'|trans }}</span>
                                </button>
                            </form>
                        </div>
                    </div>

                    {% if session.feedback %}
                        {% include '@Glossary/trainer/_feedback.html.twig' with {'feedback': session.feedback} only %}
                    {% endif %}

                    <div class="box has-text-centered" data-trainer-card>
                        <p class="title is-3 my-5"{% if question.promptLanguage %} lang="{{ question.promptLanguage }}"{% endif %}>{{ question.prompt|nl2br }}</p>

                        {% if session.answerMode.value == 'flip' %}
                            {% if not revealed %}
                                <a href="{{ path('app_plugin_glossary_trainer_card', {reveal: 1}) }}" class="button is-link" rel="nofollow" data-trainer-reveal>
                                    {{ 'glossary_trainer.button_reveal'|trans }}
                                </a>
                            {% endif %}
                            <div class="{{ revealed ? '' : 'is-hidden' }}" data-trainer-answer>
                                <hr>
                                <p class="is-size-4"{% if question.answerLanguage %} lang="{{ question.answerLanguage }}"{% endif %}>{{ question.answer|nl2br }}</p>
                                {% if question.secondary %}<p class="has-text-grey">{{ question.secondary }}</p>{% endif %}
                                <form method="post" action="{{ path('app_plugin_glossary_trainer_answer') }}" class="mt-5">
                                    <input type="hidden" name="_token" value="{{ csrf_token('glossary_trainer_answer') }}">
                                    <input type="hidden" name="entry" value="{{ question.entry.id }}">
                                    <div class="buttons is-centered">
                                        {% for grade in grades %}
                                            <button type="submit" name="grade" value="{{ grade.value }}" class="button is-light {{ gradeClass[grade.value] }}" data-trainer-key="{{ grade.value }}">
                                                {{ grade.label()|trans }}
                                                <span class="tag is-white ml-2">{{ grade.value }}</span>
                                            </button>
                                        {% endfor %}
                                    </div>
                                </form>
                            </div>
                        {% elseif session.answerMode.value == 'choice' %}
                            <form method="post" action="{{ path('app_plugin_glossary_trainer_answer') }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('glossary_trainer_answer') }}">
                                <input type="hidden" name="entry" value="{{ question.entry.id }}">
                                {% for choice in question.choices %}
                                    <button type="submit" name="choice" value="{{ choice.id }}" class="button is-fullwidth mb-2 has-text-left" data-trainer-key="{{ loop.index }}"{% if question.answerLanguage %} lang="{{ question.answerLanguage }}"{% endif %}>
                                        <span class="tag is-light mr-2">{{ loop.index }}</span>
                                        {{ choice.text }}
                                    </button>
                                {% endfor %}
                            </form>
                        {% else %}
                            <form method="post" action="{{ path('app_plugin_glossary_trainer_answer') }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('glossary_trainer_answer') }}">
                                <input type="hidden" name="entry" value="{{ question.entry.id }}">
                                <div class="field has-addons has-addons-centered">
                                    <div class="control is-expanded">
                                        <input class="input" type="text" name="typed" autocomplete="off" autofocus
                                               aria-label="{{ 'glossary_trainer.typing_label'|trans }}"
                                               placeholder="{{ 'glossary_trainer.typing_label'|trans }}"{% if question.answerLanguage %} lang="{{ question.answerLanguage }}"{% endif %}>
                                    </div>
                                    <div class="control">
                                        <button type="submit" class="button is-primary">{{ 'glossary_trainer.button_check'|trans }}</button>
                                    </div>
                                </div>
                            </form>
                        {% endif %}
                    </div>

                    <div class="buttons is-centered are-small">
                        <a href="{{ path('app_plugin_glossary_trainer_mark', {id: question.entry.id, return: 'card'}) }}"
                           class="button{{ question.marked ? ' is-warning' : ' is-light' }}"
                           data-post
                           data-csrf-token="{{ csrf_token('glossary_trainer_mark' ~ question.entry.id) }}">
                            <span class="icon"><i class="fa fa-star"></i></span>
                            <span>{{ (question.marked ? 'glossary_trainer.button_unmark' : 'glossary_trainer.button_mark')|trans }}</span>
                        </a>
                    </div>

                    {% if session.answerMode.value != 'typing' %}
                        <p class="has-text-centered is-size-7 has-text-grey">{{ 'glossary_trainer.keyboard_hint'|trans }}</p>
                    {% endif %}

                </div>
            </div>
        </div>
    </section>

{% endblock %}
