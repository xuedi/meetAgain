{% extends 'base.html.twig' %}

{% block title %}{{ 'glossary.page_title'|trans }}{% endblock %}

{% block javascripts %}
    <script src="{{ asset('js/vendor/jstable.min.js') }}"></script>
{% endblock %}

{% block body %}

    <section class="section">
        <div class="container">

            <div class="level mb-4">
                <div class="level-left">
                    <h1 class="title mb-0">{{ 'glossary.page_title'|trans }}</h1>
                </div>
                {% if is_granted('ROLE_ORGANIZER') %}
                    <div class="level-right buttons">
                        <a href="{{ path('app_plugin_glossary_import') }}" class="button">
                            <span class="icon"><i class="fa fa-upload"></i></span>
                            <span>{{ 'glossary.button_import'|trans }}</span>
                        </a>
                        <a href="{{ path('app_plugin_glossary_new') }}" class="button is-link">
                            <span class="icon"><i class="fa fa-plus"></i></span>
                            <span>{{ 'glossary.button_new'|trans }}</span>
                        </a>
                    </div>
                {% elseif is_granted('ROLE_USER') %}
                    <div class="level-right">
                        <a href="{{ path('app_contribution_suggest', {type: 'glossary'}) }}" class="button is-link">
                            <span class="icon"><i class="fa fa-plus"></i></span>
                            <span>{{ 'glossary.button_suggest_new'|trans }}</span>
                        </a>
                    </div>
                {% endif %}
            </div>

            {% embed '_components/item/list_layout.html.twig' with {
                'itemType': 'glossary',
                'modes': ['list', 'tiles'],
                'infoKey': 'glossary.sidebar_info',
                'trainerSummary': trainerSummary
            } only %}
                {% block item_sidebar_extra %}
                    {% if is_granted('ROLE_USER') %}
                        {% include '@Glossary/item/_training_box.html.twig' with {'summary': trainerSummary} only %}
                    {% endif %}
                {% endblock %}
            {% endembed %}

        </div>
    </section>

{% endblock %}
