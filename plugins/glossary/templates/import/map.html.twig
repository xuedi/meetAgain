{% extends 'base.html.twig' %}

{% block title %}{{ 'glossary_import.page_title'|trans }}{% endblock %}

{% block body %}

    <section class="section">
        <div class="container">
            <div class="columns is-centered">
                <div class="column is-two-thirds">

                    <h1 class="title is-4">{{ 'glossary_import.map_title'|trans }}</h1>
                    <p class="mb-4">{{ 'glossary_import.map_intro'|trans({'%rows%': rowCount}) }}</p>

                    <div class="box">
                        {{ form_start(form) }}
                        {{ form_errors(form) }}
                        <div class="columns is-multiline">
                            <div class="column is-half">{{ form_row(form.termColumn) }}</div>
                            <div class="column is-half">{{ form_row(form.definitionColumn) }}</div>
                            <div class="column is-half">{{ form_row(form.secondaryColumn) }}</div>
                            <div class="column is-half">{{ form_row(form.tagsColumn) }}</div>
                            <div class="column is-half">{{ form_row(form.language) }}</div>
                            <div class="column is-half">{{ form_row(form.targetTag) }}</div>
                            <div class="column is-full">{{ form_row(form.newTagLabel) }}</div>
                            <div class="column is-full">{{ form_row(form.duplicatePolicy) }}</div>
                        </div>
                        <div class="buttons is-right mt-4">
                            <a href="{{ path('app_plugin_glossary_import') }}" class="button is-text">{{ 'global.button_cancel'|trans }}</a>
                            {{ form_widget(form.preview) }}
                            {{ form_widget(form.import) }}
                        </div>
                        {{ form_end(form) }}
                    </div>

                    <h2 class="title is-5">{{ 'glossary_import.preview_title'|trans({'%count%': preview|length}) }}</h2>
                    {% if preview is empty %}
                        <p class="has-text-grey">{{ 'glossary_import.preview_empty'|trans }}</p>
                    {% else %}
                        <div class="table-container">
                            <table class="table is-fullwidth is-narrow is-striped">
                                <thead>
                                    <tr>
                                        <th>{{ config.primaryLabel ?? ('glossary.label_phrase'|trans) }}</th>
                                        <th>{{ config.secondaryLabel ?? ('glossary.label_secondary'|trans) }}</th>
                                        <th>{{ config.definitionLabel ?? ('glossary.label_definition'|trans) }}</th>
                                        <th>{{ 'glossary.label_tag'|trans }}</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for row in preview %}
                                        <tr>
                                            <td>{{ row.phrase }}</td>
                                            <td class="has-text-grey">{{ row.secondary }}</td>
                                            <td>{{ row.definition }}</td>
                                            <td>{{ row.tags|join(' ') }}</td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% endif %}

                </div>
            </div>
        </div>
    </section>

{% endblock %}
