<h1 class="title is-4">{{ 'contribution.page_title'|trans }}</h1>
<p class="subtitle is-6">{{ 'contribution.index_intro'|trans }}</p>

<div class="box">
    <h2 class="title is-5">{{ 'contribution.index_fix_heading'|trans }}</h2>
    <p>{{ 'contribution.index_fix_body'|trans }}</p>
</div>

<div class="box">
    <h2 class="title is-5">{{ 'contribution.index_new_heading'|trans }}</h2>
    <p class="mb-4">{{ 'contribution.index_new_body'|trans }}</p>
    <div class="buttons">
        {% for type, labelKey in suggestable %}
            <a class="button is-primary is-small" href="{{ path('app_contribution_suggest', {type: type}) }}">
                <span class="icon"><i class="fas fa-plus"></i></span>
                <span>{{ 'contribution.nav_suggest_new'|trans({'%type%': labelKey|trans}) }}</span>
            </a>
        {% endfor %}
    </div>
</div>

<p class="has-text-grey is-size-7">{{ 'contribution.index_review_note'|trans }}</p>
