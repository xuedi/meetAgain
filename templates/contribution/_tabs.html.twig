<div class="tabs is-boxed">
    <ul>
        {% for section in sections %}
            <li class="{{ activeType == section.type ? 'is-active' : '' }}">
                <a href="{{ path('app_contribution_section', {type: section.type}) }}">
                    <span class="icon is-small"><i class="fas {{ section.icon }}" aria-hidden="true"></i></span>
                    <span>{{ section.labelKey|trans }}</span>
                    <span class="tag is-light ml-2">{{ section.count }}</span>
                </a>
            </li>
        {% endfor %}
    </ul>
</div>
