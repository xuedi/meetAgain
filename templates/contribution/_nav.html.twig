<aside class="menu">
    <p class="menu-label">{{ section.labelKey|trans }}</p>
    <ul class="menu-list">
        {% for entry in section.entries %}
            {% set isActive = activeId == entry.id %}
            <li>
                <a class="{{ isActive ? 'is-active' : '' }}"
                   href="{{ path('app_contribution_correct', {type: section.type, id: entry.id}) }}">
                    {{ entry.label }}
                    {%- if entry.sublabel %}
                        <span class="is-size-7 ml-2{{ isActive ? '' : ' has-text-grey' }}">{{ entry.sublabel }}</span>
                    {% endif %}
                </a>
            </li>
        {% else %}
            <li><span class="is-block p-2 has-text-grey is-size-7">{{ 'contribution.nav_empty'|trans }}</span></li>
        {% endfor %}

        {% if suggestable[section.type] is defined %}
            <li>
                <a class="{{ pane == 'suggest' ? 'is-active' : '' }}"
                   href="{{ path('app_contribution_suggest', {type: section.type}) }}">
                    <span class="icon is-small"><i class="fas fa-plus" aria-hidden="true"></i></span>
                    {{ 'contribution.nav_suggest_new'|trans({'%type%': suggestable[section.type]|trans}) }}
                </a>
            </li>
        {% endif %}
    </ul>
</aside>
