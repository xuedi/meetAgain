{% extends 'base.html.twig' %}

{% block title %}{{ 'venue_ballot.page_title_close'|trans }}{% endblock %}

{% block body %}
    <section class="section">
        <div class="container">
            <h1 class="title">{{ 'venue_ballot.page_title_close'|trans }}</h1>
            <h2 class="subtitle">{{ ballot.title }}</h2>

            {% if ballot.isTied %}
                <div class="notification is-warning mb-4">{{ 'ballot.tied'|trans }}</div>
            {% else %}
                <p class="mb-4 has-text-grey">{{ 'venue_ballot.close_intro'|trans }}</p>
            {% endif %}

            <form method="post" action="{{ path('app_venue_ballot_close', {id: ballot.id}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('venue_ballot_close' ~ ballot.id) }}">

                <div class="mb-4">
                    {% for choice in choices %}
                        <div class="box mb-2">
                            <label class="radio is-flex is-align-items-center">
                                <input type="radio" name="winner" value="{{ choice.key }}" required>
                                <span class="ml-3">
                                    {{ choice.label }}
                                    <span class="is-block is-size-7 has-text-grey">
                                        {{ 'venue_ballot.count_votes'|trans({'%count%': ballot.votesFor(choice.key)}) }}
                                    </span>
                                </span>
                            </label>
                        </div>
                    {% endfor %}
                </div>

                <button type="submit" class="button is-primary">{{ 'venue_ballot.button_settle'|trans }}</button>
                <a href="{{ path('app_ballot_show', {id: ballot.id}) }}" class="button ml-2">{{ 'global.button_cancel'|trans }}</a>
            </form>
        </div>
    </section>
{% endblock %}
