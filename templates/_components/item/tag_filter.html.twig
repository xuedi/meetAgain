{#
    Item Tag Filter -- one tag chip per line for narrowing an item list

    Renders the type's tag vocabulary depth-first as Bulma tag chips that toggle, one per line, each
    sub-tag directly below the tag it hangs from and led by the tag_indent arrow. Every chip is a real
    link to a facet URL, so the box narrows the list with JavaScript disabled. Each option carries the
    number of entries it would yield against the current selection - for a parent that is every entry
    in its branch - and renders as a dimmed span instead of a link when that number is zero. Renders
    nothing when the type has no tags.

    The header row carries a pencil for any logged-in visitor - to the steward's editor, or to the
    contribution hub's tag pane - with the pending-proposal count as a badge for reviewers. It lives
    inside the swapped fragment, so it survives a facet click.

    Used in:    _components/item/sidebar.html.twig, App\Controller\ItemController::listFragment
    Parameters:
        - itemType (string, required) -- registry key of the item type (e.g. 'dish')
    Depends on: item_tag_rows(), item_tag_pending(), item_facet_current(),
                item_facet_url(), item_facet_counts() (ItemTagExtension); item_list_url()
                (ItemListExtension); _components/item/tag_indent.html.twig; the app_item_tags route
                for a steward, the contribution hub's tag pane for everyone else;
                assets/js/item-list.js for the swap, the mobile collapse and the "Show all" rows
#}
{% import _self as facet %}

{% macro chip(url, label, count, active) %}
    {% set classes = 'tag' ~ (active ? ' is-link' : ' is-light') %}
    {% if count is same as(0) and not active %}
        <span class="{{ classes }} has-text-grey-light" title="{{ 'item.facet_zero_hint'|trans }}">{{ label }}<span class="ml-1">0</span></span>
    {% else %}
        <a href="{{ url }}" class="{{ classes }}" rel="nofollow" data-item-facet>{{ label }}{% if count is not null %}<span class="ml-1 {{ active ? '' : 'has-text-grey' }}">{{ count }}</span>{% endif %}</a>
    {% endif %}
{% endmacro %}

{% set rows = item_tag_rows(itemType) %}
{% if rows is not empty %}
    {% set selection = item_facet_current() %}
    {% set counts = item_facet_counts(itemType) %}
    {% set baseUrl = item_list_url(itemType) %}
    {% set activeCount = selection.count() %}
    {% set visibleChips = 12 %}
    <div class="box item-tag-filter mb-4">
        <div class="is-flex is-justify-content-space-between is-align-items-center mb-2">
            <p class="heading mb-0">{{ 'item.facet_heading'|trans }}</p>
            <span class="is-flex is-align-items-center" style="gap: 0.5rem;">
                {% if activeCount > 0 %}
                    <a href="{{ baseUrl }}" class="is-size-7" rel="nofollow" data-item-facet>{{ 'item.facet_clear'|trans }}</a>
                {% endif %}
                {% if is_granted('ROLE_USER') %}
                    {% set isSteward = is_granted('ROLE_STEWARD') %}
                    {% set pendingCount = isSteward ? item_tag_pending(itemType) : 0 %}
                    {% set tagPageUrl = isSteward
                        ? path('app_item_tags', {itemType: itemType})
                        : path('app_contribution_correct', {type: 'tag', id: itemType}) %}
                    <a href="{{ tagPageUrl }}"
                       class="is-size-7" rel="nofollow" title="{{ 'item.tag_edit_link'|trans }}">
                        <span class="icon is-small"><i class="fa-solid fa-pen-to-square"></i></span>
                        {% if pendingCount > 0 %}<span class="tag is-warning">{{ pendingCount }}</span>{% endif %}
                    </a>
                {% endif %}
            </span>
        </div>

        <button type="button" class="button is-small is-fullwidth mb-2 is-hidden-tablet is-hidden" data-item-facet-toggle>
            <span class="icon"><i class="fa-solid fa-filter"></i></span>
            <span>{{ 'item.facet_toggle'|trans({'%count%': activeCount}) }}</span>
        </button>

        <div data-item-facet-panel>
            <div class="field" data-item-facet-axis="tag">
                {% for row in rows %}
                    <div{% if loop.index0 >= visibleChips %} class="item-facet-extra"{% endif %}>
                        <div class="is-flex is-align-items-center mb-1">
                            {{ include('_components/item/tag_indent.html.twig', {depth: row.depth}) }}
                            {{ facet.chip(
                                item_facet_url(baseUrl, selection.withTagToggled(row.id)),
                                row.label,
                                counts ? (counts.tags[row.id]|default(0)) : null,
                                selection.hasTag(row.id)
                            ) }}
                        </div>
                    </div>
                {% endfor %}
                {% if rows|length > visibleChips %}
                    <button type="button" class="tag is-white has-text-link is-hidden" data-item-facet-more>{{ 'item.facet_show_all'|trans({'%count%': rows|length}) }}</button>
                {% endif %}
            </div>
        </div>
    </div>
{% endif %}
