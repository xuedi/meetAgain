{% extends 'base.html.twig' %}

{% block title %}{{ 'item_ballot.page_title_create'|trans }}{% endblock %}

{% block body %}
    <section class="section">
        <div class="container">
            <h1 class="title">{{ 'item_ballot.page_title_create'|trans }}</h1>

            <div class="box mb-4">
                <p class="subtitle mb-1">{{ event.title(app.request.locale) }}</p>
                <p class="has-text-grey is-size-7">{{ event.start|date('d.m.Y') }}</p>
                {% if itemTypeLabelKey %}
                    <span class="tag is-light mt-2">{{ itemTypeLabelKey|trans }}</span>
                {% endif %}
            </div>

            {% if candidateItemIds is empty %}
                <div class="notification is-warning">{{ 'item_ballot.no_candidates'|trans }}</div>
                <a href="{{ path('app_event_details', {id: event.id}) }}" class="button">{{ 'global.button_cancel'|trans }}</a>
            {% else %}
                {{ form_start(form) }}
                <p class="mb-3 has-text-grey">{{ 'item_ballot.create_intro'|trans }}</p>

                <div class="mb-5">
                    {% for choice in form.items %}
                        <div class="box mb-2">
                            <label class="checkbox is-flex is-align-items-center">
                                {{ form_widget(choice) }}
                                <span class="ml-3">{{ item_list_cell(itemType, choice.vars.value, 'row') }}</span>
                            </label>
                        </div>
                    {% endfor %}
                    {% do form.items.setRendered %}
                </div>

                {{ form_widget(form.ballotTerms) }}

                <div class="field mt-5">
                    <button type="submit" class="button is-primary">{{ 'item_ballot.button_create'|trans }}</button>
                    <a href="{{ path('app_event_details', {id: event.id}) }}" class="button ml-2">{{ 'global.button_cancel'|trans }}</a>
                </div>
                {{ form_end(form) }}
            {% endif %}
        </div>
    </section>
{% endblock %}
