{% extends 'base.html.twig' %}

{% block title %}{{ 'location.page_title'|trans }}{% endblock %}

{% block body %}

    <section class="section">
        <div class="container">
            <div class="columns">

                <div class="column is-3">
                    {{ include('location/_nav.html.twig') }}
                </div>

                <div class="column is-9">
                    {% if pane == 'propose' %}
                        {{ include('location/_propose_form.html.twig') }}
                    {% elseif pane == 'suggest' %}
                        {{ include('location/_suggest_form.html.twig') }}
                    {% else %}
                        {{ include('location/_intro.html.twig') }}
                    {% endif %}
                </div>

            </div>
        </div>
    </section>

{% endblock %}
