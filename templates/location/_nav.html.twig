<nav class="panel is-shadowless">
    <p class="panel-heading">{{ 'location.nav_heading'|trans }}</p>
    {% for venue in venues %}
        <a class="panel-block{{ activeVenueId == venue.id ? ' is-active has-text-weight-bold' : '' }}"
           href="{{ path('app_location_propose', {id: venue.id}) }}">
            <span class="panel-icon"><i class="fas fa-location-dot"></i></span>
            {{ venue.name }}
        </a>
    {% else %}
        <div class="panel-block has-text-grey">{{ 'location.nav_empty'|trans }}</div>
    {% endfor %}
    <a class="panel-block has-background-white-ter{{ pane == 'suggest' ? ' is-active has-text-weight-bold' : '' }}"
       href="{{ path('app_location_suggest') }}">
        <span class="panel-icon"><i class="fas fa-plus"></i></span>
        {{ 'location.nav_suggest_new'|trans }}
    </a>
</nav>
