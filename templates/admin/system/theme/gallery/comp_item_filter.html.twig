{#
    Gallery: Item facet filter -- one chip per line, counts and the disabled zero-count option

    Static reproduction of the item-list filter box: one chip per line, the active chip filled, an
    inactive one light, and an option that would yield nothing rendered as a dimmed span instead of
    a link. A sub-tag sits directly below its parent behind the tag_indent arrow, and a parent's
    count covers its whole branch. The live box is data-driven per item type, so this entry shows
    the states rather than including the component.

    Used in:    admin/system/theme/gallery/index.html.twig
    Parameters: none
#}
<p class="is-size-7 has-text-grey">
    {{ 'admin_system_gallery.source_of_truth'|trans }}
    <code>templates/_components/item/tag_filter.html.twig</code>
</p>

<div class="columns mt-3">
    <div class="column is-narrow" style="width: 16rem;">
        <div class="box item-tag-filter">
            <div class="is-flex is-justify-content-space-between is-align-items-center mb-2">
                <p class="heading mb-0">{{ 'item.facet_heading'|trans }}</p>
                <span class="is-flex is-align-items-center" style="gap: 0.5rem;">
                    <a href="#" class="is-size-7" rel="nofollow">{{ 'item.facet_clear'|trans }}</a>
                    <a href="#" class="is-size-7" rel="nofollow" title="{{ 'item.tag_edit_link'|trans }}">
                        <span class="icon is-small"><i class="fa-solid fa-pen-to-square"></i></span>
                        <span class="tag is-warning">2</span>
                    </a>
                </span>
            </div>
            <div class="field">
                <div class="is-flex is-align-items-center mb-1">
                    <a href="#" class="tag is-link" rel="nofollow">Starter<span class="ml-1">4</span></a>
                </div>
                <div class="is-flex is-align-items-center mb-1">
                    <a href="#" class="tag is-light" rel="nofollow">Main<span class="ml-1 has-text-grey">7</span></a>
                </div>
                <div class="is-flex is-align-items-center mb-1">
                    <span class="tag is-light has-text-grey-light" title="{{ 'item.facet_zero_hint'|trans }}">Dessert<span class="ml-1">0</span></span>
                </div>
                <div class="is-flex is-align-items-center mb-1">
                    <a href="#" class="tag is-light" rel="nofollow">Meat<span class="ml-1 has-text-grey">6</span></a>
                </div>
                <div class="is-flex is-align-items-center mb-1">
                    {{ include('_components/item/tag_indent.html.twig', {depth: 2}) }}
                    <a href="#" class="tag is-light" rel="nofollow">Poultry<span class="ml-1 has-text-grey">4</span></a>
                </div>
                <div class="is-flex is-align-items-center mb-1">
                    {{ include('_components/item/tag_indent.html.twig', {depth: 3}) }}
                    <a href="#" class="tag is-light" rel="nofollow">Chicken<span class="ml-1 has-text-grey">3</span></a>
                </div>
                <div class="is-flex is-align-items-center mb-1">
                    {{ include('_components/item/tag_indent.html.twig', {depth: 2}) }}
                    <a href="#" class="tag is-light" rel="nofollow">Pork<span class="ml-1 has-text-grey">2</span></a>
                </div>
            </div>
        </div>
    </div>
    <div class="column">
        <div class="item-result-header mb-3">
            <p class="is-size-7 has-text-grey">{{ 'item.result_showing'|trans({'%shown%': 4, '%total%': 11}) }}</p>
            <div class="tags mt-2">
                <a href="#" class="tag is-link" rel="nofollow">Starter <span class="icon is-small ml-1"><i class="fa-solid fa-xmark"></i></span></a>
                <a href="#" class="tag is-light" rel="nofollow">{{ 'item.facet_clear'|trans }}</a>
            </div>
        </div>
        <p class="has-text-grey is-size-7">{{ 'admin_system_gallery.item_filter_body'|trans }}</p>
    </div>
</div>
